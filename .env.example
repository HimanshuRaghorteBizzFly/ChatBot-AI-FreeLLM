# ============================================================
# Chatbot Production & Development Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file with secrets to Git.
# ============================================================

# Application Environment (development, staging, production, testing)
APP_ENV=development

# Server & Network Settings
HOST=127.0.0.1
PORT=8501
ALLOWED_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
MAX_UPLOAD_SIZE_MB=25
REQUEST_TIMEOUT_SECONDS=45
ENABLE_RATE_LIMITING=true

# Database Configuration (SQLite default with WAL mode)
# For PostgreSQL in production: postgresql://user:password@localhost:5432/chat_db
DATABASE_URL=sqlite:///data/app.db

# ============================================================
# AI Provider API Keys (Keep these private!)
# ============================================================

# 1. OpenRouter API Key
# Powers: NVIDIA Nemotron 3.5 Super VL, Microsoft MAI-Image-2.7 Flash, Llama 3.3 70B
# Free key console: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Google Gemini API Key
# Powers: Gemini 3.1 Flash Lite, Gemini 3.8 Flash, Multimodal Vision, Text Embeddings
# Free key console: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Groq API Key
# Powers: GPT-OSS 120B/20B (500+ tokens/s) & Whisper Large V3 Speech-to-Text
# Free key console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 4. Ollama Cloud Key (Optional - leave empty for local Ollama on http://localhost:11434)
# Console: https://ollama.com
OLLAMA_API_KEY=
OLLAMA_HOST=http://localhost:11434
